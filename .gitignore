# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Secrets ---
.env
.env.*
!.env.example

# --- DVC ---
# Les données sont versionnées par DVC (fichiers .dvc / dvc.lock), pas par git.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
.dvc/config.local
.dvc/tmp/
.dvc/cache/

# --- MLflow / Prefect ---
mlruns/
mlartifacts/
.prefect/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
